{
  "expo": {
    "name": "Time-Up",
    "slug": "time-up",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/Icon.svg",
    "scheme": "timeup",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anit7215.timeup",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.timeup",
      "googleServicesFile": "./google-services.json",
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "timeup"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "9c20f662-9b60-4723-b1c0-84162a28c664"
      },"googleAndroidClientId": "128891005006-3puuui45deiveh77otbqmlvqni6ih3ov.apps.googleusercontent.com",
      "googleIosClientId": "128891005006-52nn0s4ebirsugkov1lbip9h32dm55tr.apps.googleusercontent.com",
      "expoClientId": "340998244534-4u40uhomsb5iphtjpl64nbr345podhjb.apps.googleusercontent.com"
    },
    "owner": "anit7215"
  }
}